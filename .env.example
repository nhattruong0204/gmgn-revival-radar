# Read-only GMGN API key from https://gmgn.ai/ai. No wallet/private key needed.
GMGN_API_KEY=
# Optional independent Solana mint/freeze-authority verification. Never used for prices.
HELIUS_API_TOKEN=
HELIUS_ENABLED=true
HELIUS_CACHE_TTL_SECONDS=900
MAX_HELIUS_VERIFY_PER_SCAN=20
HELIUS_SCAN_BUDGET_SECONDS=15
HELIUS_REQUEST_SPACING_SECONDS=0.12
HELIUS_HTTP_TIMEOUT_SECONDS=10
HELIUS_HTTP_ATTEMPTS=2
HELIUS_RETRY_MAX_WAIT_SECONDS=2
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Private-chat controls infer the owner from a positive numeric TELEGRAM_CHAT_ID.
# For alerts sent to a channel/group, set your personal numeric user ID explicitly.
TELEGRAM_OWNER_ID=0
TELEGRAM_CONTROLS_ENABLED=true
ALERTS_PAUSED=false
EXCLUDE_TOKENIZED_STOCKS=true
EXCLUDE_STABLECOINS=true
EXCLUDE_WRAPPED_ASSETS=true
# Opt in through Telegram > Alerts > Daily summary, or set this here.
DAILY_SUMMARY_ENABLED=false
DAILY_SUMMARY_HOUR=9
# Solana top-ten score report at 00:00/04:00/08:00/12:00/16:00/20:00 in REPORT_TIMEZONE.
# Independent of signal thresholds and ALERTS_PAUSED; DRY_RUN still suppresses delivery.
MARKET_REPORT_ENABLED=true
REPORT_TIMEZONE=Asia/Bangkok
ENABLED_CHAINS=sol
SCAN_INTERVAL_SECONDS=300
DATABASE_PATH=data/revival_radar.db
TOKEN_MIN_AGE_HOURS=48
MIN_MARKET_CAP=100000
MAX_MARKET_CAP=10000000
MIN_LIQUIDITY=30000
MIN_HOLDERS=300
MIN_ATH_DRAWDOWN=0.65
MAX_ATH_DRAWDOWN=0.95
MIN_VOLUME_1H=50000
MAX_PRICE_CHANGE_5M=30
MAX_PRICE_CHANGE_1H=75
ALERT_SCORE_THRESHOLD=75
ALERT_COOLDOWN_HOURS=6
REALERT_SCORE_INCREASE=10
DRY_RUN=true
LOG_LEVEL=INFO
# Hot Search only. Opt in deliberately to add the GMGN /v1/market/rank endpoint.
TRENDING_DISCOVERY_ENABLED=false
DISCOVERY_INTERVAL=1h
DISCOVERY_LIMIT=20
WATCHLIST_HOURS=24
WATCHLIST_LIMIT=100
# Leave unset to use WATCHLIST_HOURS (including existing Telegram overrides).
# WATCHLIST_EXPIRE_HOURS=24
WATCHLIST_HIGH_SCORE_INTERVAL_SECONDS=150
WATCHLIST_NORMAL_INTERVAL_SECONDS=600
SECURITY_CACHE_TTL_SECONDS=1800
KLINE_CACHE_TTL_SECONDS=900
MAX_MARKET_ENRICH_PER_SCAN=40
MAX_SECURITY_ENRICH_PER_SCAN=8
MAX_KLINE_FETCH_PER_SCAN=12
HISTORY_OBSERVATIONS=6
MINIMUM_HISTORY_OBSERVATIONS=3
HISTORY_MAX_GAP_SECONDS=900
ACCELERATION_CAP=20
VOLUME_ACCELERATION_THRESHOLD=1.5
TX_ACCELERATION_THRESHOLD=1.5
# Activity bonuses require ratio acceleration AND matching-window absolute floors.
MIN_TX_5M_FOR_ACCELERATION=10
MIN_TX_1H_FOR_ACCELERATION=60
MIN_VOLUME_5M_FOR_ACCELERATION=2000
MIN_VOLUME_5M_LIQUIDITY_RATIO=0.01
MIN_VOLUME_1H_LIQUIDITY_RATIO=0.06
VOLATILITY_COMPRESSION_THRESHOLD=0.25
# JSON arrays: four base-credit bands plus the optional maturity-bonus threshold.
BASE_MATURITY_HOURS=[6,12,24,48,72]
BASE_MATURITY_FRACTIONS=[0.3333333333333333,0.5333333333333333,0.8,1]
STRONG_BASE_MIN_HOURS=48
CONFIRMED_BASE_MIN_HOURS=72
WATCH_SCORE_THRESHOLD=40
EARLY_REVIVAL_SCORE_THRESHOLD=60
REVIVING_SCORE_THRESHOLD=70
STRONG_REVIVAL_SCORE_THRESHOLD=80
CONFIRMED_REVIVAL_SCORE_THRESHOLD=85
HOT_RANK_IMPROVEMENT=10
BASE_MIN_HOURS=24
BASE_SUFFICIENT_HOURS=72
BASE_MAX_RANGE_RATIO=0.25
KLINE_LOOKBACK_HOURS=168
HTTP_TIMEOUT_SECONDS=20
HTTP_ATTEMPTS=3
REQUEST_SPACING_SECONDS=1.5
RETRY_MAX_WAIT_SECONDS=10
# Optional score overrides (all weights in config.py, positive magnitudes):
# Dimension scores are each 0-100; overall default allocation is 30:40:30.
# WEIGHTS__SETUP_DIMENSION=30
# WEIGHTS__TRIGGER_DIMENSION=40
# WEIGHTS__CONFIRMATION_DIMENSION=30
# WEIGHTS__COMPRESSION=5
# WEIGHTS__TRENDING=5
# WEIGHTS__RETEST=5
# WEIGHTS__BASE=15
# WEIGHTS__DANGER_PENALTY=40
# Bind-mounted data must be writable by this container identity.
# On Linux set these to the output of id -u / id -g before Docker startup.
RADAR_UID=10001
RADAR_GID=10001
