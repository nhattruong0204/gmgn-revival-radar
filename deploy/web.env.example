# Copy to /etc/revival-radar/web.env, owned by root with mode 600.
# The web process does not need any GMGN, Helius or Telegram credentials.
DATABASE_PATH=/opt/gmgn-revival-radar/data/revival_radar.db
WEB_STATIC_DIRECTORY=/opt/gmgn-revival-radar/web/dist
WEB_ADMIN_ENABLED=false
# Keep fixture data excluded from public research in production.
WEB_ALLOW_SYNTHETIC_DATA=false
# Enable owner access only after securely generating and storing a password hash.
WEB_ADMIN_PASSWORD_HASH=
WEB_COOKIE_SECURE=true
WEB_TRUSTED_ORIGIN=https://onchainflow.app
# Optional public channel link; never a private owner identifier.
WEB_TELEGRAM_URL=
WEB_PUBLIC_RATE_LIMIT=120
WEB_READ_TIMEOUT_MS=1500
