# Copy to .env.web, mode 600. Requires Compose >=2.30 for raw env_file support.
# Do not quote or interpolate the password hash in this raw-format file.
# Provider/Telegram secrets belong only to the scanner's .env.
DATABASE_PATH=/app/data/revival_radar.db
WEB_ADMIN_ENABLED=false
WEB_ADMIN_PASSWORD_HASH=
WEB_COOKIE_SECURE=true
WEB_TRUSTED_ORIGIN=https://radar.example.com
WEB_TELEGRAM_URL=
WEB_PUBLIC_RATE_LIMIT=120
WEB_READ_TIMEOUT_MS=1500
WEB_CACHE_SECONDS=10
